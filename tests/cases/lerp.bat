; raylib-lerp: start, end, amount. Integers are accepted where floats are.
(println (raylib-lerp 0.0 10.0 0.25))
(println (raylib-lerp 1.0 2.0 0.5))
(println (raylib-lerp 0.0 10.0 0.0))
(println (raylib-lerp 0.0 10.0 1.0))
(println (raylib-lerp 0 10 0.75))
(println (raylib-lerp 10.0 0.0 0.25))
(exit)
